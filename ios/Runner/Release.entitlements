<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Keychain Sharing — see DebugProfile.entitlements. The offline lecture
	  cipher's installation secret lives in the keychain, so the release build
	  needs the same capability or encrypted downloads cannot be written.
	-->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
