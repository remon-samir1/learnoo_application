<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Keychain Sharing — see DebugProfile.entitlements. The offline lecture
	  cipher's installation secret lives in the keychain, so the release build
	  needs the same capability or encrypted downloads cannot be written.
	-->
	<!--
	  Push Notifications (PushService / Firebase Cloud Messaging → APNs).
	  Xcode replaces "development" with "production" when the archive is
	  exported for the App Store.
	-->
	<!--
	  Associated Domains: exam and live session links on learnoo.app open the
	  app (https://learnoo.app/.well-known/apple-app-site-association).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:learnoo.app</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
